# Copy to .env for local dev. In Netlify, set these under Site settings > Environment variables.

# --- Front-end (safe to expose; VITE_ prefix bundles them into the client) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server only (NEVER prefix with VITE_; stays in the Netlify function) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
